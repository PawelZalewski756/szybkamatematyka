+/** `\(...\)` → `$...$` oraz `\[...\]` → `$$...$$`. */
+export function convertLatexDelimiters(text: string): string {
+  if (!text.includes("\\(") && !text.includes("\\[") && !text.includes("\\)") && !text.includes("\\]")) {
+    return text;
+  }
+  return text
+    .replace(/\\\[/g, "$$$$")
+    .replace(/\\\]/g, "$$$$")
+    .replace(/\\\(/g, "$$")
+    .replace(/\\\)/g, "$$");
+}
