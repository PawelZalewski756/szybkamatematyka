+  out = out
+    .replace(/\\(?:left|right|bigl|bigr|Bigl|Bigr|bigg|Bigg|big|Big)\b/g, "")
+    .replace(/\\(?:displaystyle|textstyle|limits|nolimits)\b/g, "")
+    .replace(/\\(?:quad|qquad|enspace|thinspace|negthinspace)\b/g, " ")
+    .replace(/\\[!,;:]/g, "")
