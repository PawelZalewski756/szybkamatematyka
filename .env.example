# Skopiuj do .env.local i uzupełnij wartości.
#   cp .env.example .env.local

# --- Supabase (wymagane do logowania / profilu / bazy) ---
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
# Service role — tylko lokalnie / skrypty seed / webhook Stripe (NIGDY w przeglądarce)
SUPABASE_SERVICE_ROLE_KEY=

# --- Strona (SEO, redirecty, Stripe return URL) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin (/admin) — lista e-maili po przecinku ---
ADMIN_EMAILS=twoj@email.pl
NEXT_PUBLIC_ADMIN_EMAILS=twoj@email.pl

# --- Gemini (rozwiązania CKE, teoria, asysta AI) ---
GEMINI_API_KEY=
# Opcjonalnie: model Flash-Lite ma wyższy limit na free tier
GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL_FALLBACK=

# --- Stripe (opcjonalnie — monetyzacja PRO) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ROCZNY=

# --- Monitoring (opcjonalnie) ---
# Sentry: bez DSN aplikacja tylko loguje JSON na stdout. Nie commituj DSN.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
