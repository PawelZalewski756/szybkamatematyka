# Skopiuj do .env.local i uzupełnij wartości.
#   cp .env.example .env.local

# --- Supabase (wymagane do logowania / profilu / bazy) ---
NEXT_PUBLIC_SUPABASE_URL=https://TWOJ-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon
# Service role - tylko lokalnie / skrypty seed / webhook Stripe (NIGDY w przeglądarce).
# Wymagany też do statystyk zadań wszystkich uczniów (bot Telegram /stats i /users,
# panel /admin/analityka), bo solved_tasks ma RLS "tylko własne wiersze".
SUPABASE_SERVICE_ROLE_KEY=

# --- Strona (SEO, redirecty, Stripe return URL) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google Ads (gtag) - opcjonalnie; domyślnie AW-18540137652 ---
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18540137652
# NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_CONVERSION=AW-18540137652/BSrGCOqOgq4dELSZ0IhF
# Etykieta konwersji „Zakup PRO” (Google Ads -> Konwersje -> Zakup PRO -> send_to).
# Bez niej kampanie uczą się wyłącznie na rejestracjach, a nie na sprzedaży.
# Domyślnie używana jest etykieta akcji „Zakup PRO” z tego konta; zmienna ją nadpisuje.
# NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_CONVERSION=AW-18540137652/TWOJA_ETYKIETA

# --- Admin (/admin) - lista e-maili po przecinku ---
ADMIN_EMAILS=twoj@email.pl
NEXT_PUBLIC_ADMIN_EMAILS=twoj@email.pl

# --- Dane operatora (wymagane przed publikacją regulaminu) ---
# NEXT_PUBLIC_OPERATOR_NAME=
# NEXT_PUBLIC_OPERATOR_ADDRESS=
# NEXT_PUBLIC_OPERATOR_NIP=
# NEXT_PUBLIC_OPERATOR_EMAIL=

# --- Telegram admin bot (wyłącznie po stronie serwera) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_IDS=123456789
# TELEGRAM_WEBHOOK_SECRET=losowy-sekret-z-1-do-256-znakow
# TELEGRAM_SETUP_SECRET=losowy-sekret-do-jednorazowego-podlaczenia-webhooka
# Opcjonalny sekret dla backfillu powiadomień o kontach:
# TELEGRAM_SIGNUP_SECRET=
# Administrator musi wcześniej wysłać botowi /start, by odbierać powiadomienia.
# Diagnostyka: /admin/telegram.

# --- Gemini (rozwiązania CKE, teoria, asysta AI) ---
GEMINI_API_KEY=
# Opcjonalnie: model Flash-Lite ma wyższy limit na free tier
GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_MODEL_FALLBACK=

# --- Stripe (opcjonalnie - monetyzacja PRO) ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ROCZNY=

# --- Zgłoszenia błędów (Resend) ---
# Klucz API: https://resend.com/api-keys
RESEND_API_KEY=
# Adres, na który mają przychodzić zgłoszenia
BUG_REPORT_TO=kontakt@szybkamatematyka.pl
# Nadawca; bez zweryfikowanej domeny w Resend zostaw onboarding@resend.dev
BUG_REPORT_FROM=Szybka Matematyka <onboarding@resend.dev>
# Opcjonalny nadawca maila powitalnego (wymaga zweryfikowanej domeny w Resend)
# WELCOME_EMAIL_FROM=Szybka Matematyka <kontakt@szybkamatematyka.pl>

# --- Vercel Cron: powiadomienia o nowych kontach i kwalifikacja poleceń ---
# Vercel wysyła Authorization: Bearer <CRON_SECRET> do cronów.
# Dotyczy /api/telegram/sync-signups oraz /api/cron/referrals.
CRON_SECRET=

# --- Mail z przeprosinami za zgłoszenie błędu (opcjonalnie) ---
# Lista adresów rozdzielona przecinkami; można też podać --to=...
BUG_REPORTER_EMAILS=
